# ============================================================
# NOVELLE STUDIO — contoh konfigurasi
# Copy ke .env.local lalu isi nilainya.
#
# Tanpa Supabase, aplikasi tetap jalan memakai default dari data/*.ts dan
# menyimpan perubahan admin ke content/*.json (cocok untuk dev offline).
# ============================================================

# ---------- situs ----------
# Dipakai untuk canonical URL, OG tags, sitemap, dan JSON-LD.
NEXT_PUBLIC_SITE_URL=https://novellestudio.id

# ---------- Supabase (server-only, JANGAN pakai prefix NEXT_PUBLIC_) ----------
# Supabase → Project Settings → API. Tempel Project URL dan service/secret key.
# Key ini melewati RLS — hanya boleh dipakai di server action / route handler.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Cloudinary (upload QRIS & gambar dari dashboard) ----------
# Cloudinary → Settings → Upload → Add upload preset → Signing mode: Unsigned.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------- Login admin ----------
# Selama ADMIN_PASSWORD kosong, /admin terbuka (berguna saat dev).
# WAJIB diisi sebelum Supabase tersambung supaya tidak ada yang bisa ubah harga.
ADMIN_PASSWORD=
# Opsional: kunci HMAC untuk cookie sesi. Kalau kosong, ADMIN_PASSWORD dipakai.
ADMIN_SESSION_SECRET=
